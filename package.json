{
  "name": "orbis",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "prestart": "node scripts/generate-env.mjs",
    "start": "ng serve",
    "prebuild": "node scripts/generate-env.mjs",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "typecheck": "ng build --configuration development",
    "db:types": "node scripts/generate-database-types.mjs",
    "format": "prettier --write \"src/**/*.{ts,html,scss,css}\" \"scripts/**/*.mjs\" \"README.md\" \"angular.json\" \"eslint.config.js\" \"package.json\" \"tsconfig*.json\" \"tailwind.config.js\" \".postcssrc.json\"",
    "lint": "npm run format && ng lint --fix",
    "lint:check": "prettier --check \"src/**/*.{ts,html,scss,css}\" \"scripts/**/*.mjs\" \"README.md\" \"angular.json\" \"eslint.config.js\" \"package.json\" \"tsconfig*.json\" \"tailwind.config.js\" \".postcssrc.json\" && ng lint"
  },
  "private": true,
  "packageManager": "npm@11.12.1",
  "dependencies": {
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/router": "^22.2.0",
    "@supabase/supabase-js": "^2.117.1",
    "lucide": "^1.47.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.0",
    "@angular/cli": "^22.2.0",
    "@angular/compiler-cli": "^22.2.0",
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "angular-eslint": "22.5.0",
    "autoprefixer": "^10.6.1",
    "eslint": "^10.9.1",
    "jsdom": "^30.0.0",
    "postcss": "^8.5.28",
    "prettier": "^3.8.1",
    "supabase": "^2.120.0",
    "tailwindcss": "^3.4.17",
    "typescript": "~6.0.2",
    "typescript-eslint": "8.69.0",
    "vitest": "^5.0.0"
  }
}
